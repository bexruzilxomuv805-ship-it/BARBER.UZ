# Telegram bot (server/bot) — copy this file to .env and fill in the values.
#
# 1. Message @BotFather on Telegram, send /newbot, follow the prompts —
#    it gives you a token that looks like 123456789:AA...
# 2. Put that token below, then run `npm run bot` and send /start to your
#    bot — it replies with your numeric chat id. Put that below too.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Same bot's @username (no @), exposed to the frontend (Vite requires the
# VITE_ prefix) so the "Login with Telegram" button can build a t.me deep link.
VITE_TELEGRAM_BOT_USERNAME=

# Telegram @username (no @) of the one person allowed to run /foydalanuvchilar
# — list, promote/demote, or remove accounts that joined via the bot.
TELEGRAM_SUPER_ADMIN_USERNAME=

# Public site URL the bot links to (e.g. a "🌐 Saytga o'tish" button on
# /start). Defaults to the deployed Vercel URL if left empty — see
# SITE_URL in server/bot/index.js.
SITE_URL=

# Backend URL for production builds (e.g. a Render deployment). Leave empty
# for local dev — src/api/client.js falls back to http://localhost:4000.
# Set this in Vercel's Environment Variables, not here.
VITE_API_BASE_URL=

# Postgres connection string (server/pgserver.js and scripts/migrate-to-postgres.mjs).
# Get one free at neon.tech or supabase.com. Local dev and production point
# at the SAME database on purpose — see CLAUDE.md — so run
# `npm run migrate` once after setting this to create the tables.
DATABASE_URL=
